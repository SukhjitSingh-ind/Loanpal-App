rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the authenticated user owns the target document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Validate profile fields and data types
    function isValidProfileData(data) {
      return data.keys().hasAll(['uid', 'username', 'firstName', 'lastName', 'email'])
        && data.keys().hasOnly(['uid', 'username', 'firstName', 'lastName', 'email', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 20
        && data.firstName is string && data.firstName.size() >= 2 && data.firstName.size() <= 50
        && data.lastName is string && data.lastName.size() >= 2 && data.lastName.size() <= 50
        && data.email is string && data.email.size() > 3;
    }

    // Profile documents in the 'users' collection
    match /users/{userId} {
      // Users may only read their own personal profile document
      allow read: if isOwner(userId);

      // Users can only create their own profile matching authenticated UID
      allow create: if isOwner(userId)
                    && isValidProfileData(request.resource.data)
                    && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == request.time);

      // Users can update their profile; uid and createdAt must remain immutable
      allow update: if isOwner(userId)
                    && isValidProfileData(request.resource.data)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Deleting user profiles directly from client is prohibited
      allow delete: if false;
    }

    // Deny access to any other document path by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
